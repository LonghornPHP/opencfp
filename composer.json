{
    "name": "opencfp/opencfp",
    "description": "OpenCFP is a PHP-based conference talk submission system.",
    "license": "MIT",
    "require": {
        "cartalyst/sentinel": "^7.0",
        "doctrine/annotations": "^2.0",
        "doctrine/dbal": "^3.9",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^2.20",
        "ezyang/htmlpurifier": "^4.17",
        "guzzlehttp/guzzle": "^7.9",
        "http-interop/http-factory-guzzle": "^1.2",
        "illuminate/container": "^10.0",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "illuminate/support": "^10.0",
        "illuminate/validation": "^10.0",
        "intervention/image": "^2.7",
        "michelf/php-markdown": "^1.9",
        "monolog/monolog": "^3.6",
        "oneup/flysystem-bundle": "^4.14",
        "pagerfanta/pagerfanta": "^4.10",
        "php": "^8.3",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1",
        "sensio/framework-extra-bundle": "^6.2",
        "symfony/cache": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/dom-crawler": "^6.4",
        "symfony/error-handler": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/mailer": "^6.4",
        "symfony/monolog-bridge": "^6.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/options-resolver": "^6.4",
        "symfony/password-hasher": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/property-info": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/stopwatch": "^6.4",
        "symfony/string": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bridge": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/var-dumper": "^6.4",
        "symfony/var-exporter": "^6.4",
        "symfony/yaml": "^6.4",
        "twig/twig": "^3.10",
        "wouterj/eloquent-bundle": "^2.8"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "laravel/legacy-factories": "^1.4",
        "league/flysystem-memory": "^3.0",
        "localheinz/test-util": "^1.6",
        "mikey179/vfsstream": "^1.6.12",
        "mockery/mockery": "^1.6",
        "phpspec/prophecy": "^1.19",
        "phpunit/phpunit": "^9.6",
        "symfony/browser-kit": "^6.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "infection/extension-installer": false
        }
    },
    "autoload": {
        "psr-4": {
            "OpenCFP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCFP\\Test\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "scripts": {
        "fix": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no",
        "make": "make",
        "migrate": "./script/migrate",
        "psalm": "./script/psalm",
        "setup-env": "./script/setup",
        "test": "./script/test",
        "update-env": "./script/update"
    }
}
