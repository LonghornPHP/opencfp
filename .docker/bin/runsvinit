#!/bin/sh

sv_stop() {
    for s in /etc/service/*;
    do
        sv stop "$s"
    done
}

mkdir -p /srv/application/cache/production /srv/application/web/uploads /srv/application/log
chown -R nginx:nginx /srv/application/web/uploads /srv/application/cache /srv/application/log

trap "sv_stop; exit" SIGTERM
runsvdir /etc/service &
wait
